  m_Script: {fileID: 11500000, guid: f1fbfdbcd084b46b4a80017c7d9e2d64, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  dialoguePrefab: {fileID: 5190122297449860569, guid: 585e17f19f0dd4645b755d716a43f03d, type: 3}
  dialogueLines:
  - characterName: "\u0411\u043E\u0433\u0434\u0430\u043D"
    dialogueText: "\u042F \u0432\u0441\u0451 \u0441\u043E\u0431\u0440\u0430\u043B"
    characterSprite: {fileID: 561893497712537133, guid: 385f3cd55501e46e184f86a59db9d172, type: 3}
  - characterName: "\u0410\u043D\u0442\u043E\u043D"
    dialogueText: "\u041E\u0442\u043B\u0438\u0447\u043D\u043E, \u0442\u0435\u043F\u0435\u0440\u044C \u043C\u043E\u0436\u0435\u0448\u044C \u0438\u0434\u0442\u0438 \u043A \u0421\u0442\u0430\u0440\u0435\u0439\u0448\u0438\u043D\u0435, \u043F\u0440\u044F\u043C\u043E \u043D\u0430\u043F\u0440\u0430\u0432\u043E"
    characterSprite: {fileID: 878463355533298886, guid: ec8c55271a1204ea4886055ab20b4d82, type: 3}
  - characterName: "\u0411\u043E\u0433\u0434\u0430\u043D"
    dialogueText: "\u0410\u043D\u0442\u043E\u043D, \u0442\u044B \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0439 \u0434\u0440\u0443\u0433. \u042D\u0445, \u0435\u0441\u043B\u0438 \u0431\u044B \u044F \u0436\u0438\u043B \u0441 \u0432\u0430\u043C\u0438..."
    characterSprite: {fileID: 1415015729033896243, guid: 45f0e061ca13b45a5bf2c225ad4e3e9e, type: 3}
  - characterName: "\u0410\u043D\u0442\u043E\u043D"
    dialogueText: "\u041B\u0430\u0434\u043D\u043E, \u043C\u043E\u0436\u0435\u0448\u044C \u043D\u0430\u0437\u044B\u0432\u0430\u0442\u044C \u043C\u0435\u043D\u044F \"\u0410\u043D\u0442\u043E\u043D\""
    characterSprite: {fileID: 2845491494293411322, guid: 702d91e8ec55546738765ca6ed379c4c, type: 3}
  - characterName: "\u0410\u043D\u0442\u043E\u043D"
    dialogueText: "\u0410 \u0442\u0435\u043F\u0435\u0440\u044C \u0438\u0434\u0442\u0438 \u043A \u0421\u0442\u0430\u0440\u0435\u0439\u0448\u0438\u043D\u0435"
    characterSprite: {fileID: 878463355533298886, guid: ec8c55271a1204ea4886055ab20b4d82, type: 3}
