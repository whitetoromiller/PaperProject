--- !u!114 &1883312983
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1883312979}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f1fbfdbcd084b46b4a80017c7d9e2d64, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  dialoguePrefab: {fileID: 5190122297449860569, guid: 585e17f19f0dd4645b755d716a43f03d, type: 3}
  dialogueLines:
  - characterName: "\u0411\u043E\u0433\u0434\u0430\u043D"
    dialogueText: "\u042F \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F \u0438 \u043F\u0440\u0438\u043D\u0451\u0441 \u0432\u0441\u0451, \u0447\u0442\u043E \u0412\u044B \u043F\u0440\u043E\u0441\u0438\u043B\u0438"
    characterSprite: {fileID: 561893497712537133, guid: 385f3cd55501e46e184f86a59db9d172, type: 3}
  - characterName: "\u0421\u0442\u0430\u0440\u0435\u0439\u0448\u0438\u043D\u0430"
    dialogueText: "\u0425\u043C, \u0438 \u043F\u0440\u0430\u0432\u0434\u0430. \u042F \u043D\u0435 \u0434\u0443\u043C\u0430\u043B, \u0447\u0442\u043E \u0442\u044B \u0432\u0435\u0440\u043D\u0451\u0448\u044C\u0441\u044F."
    characterSprite: {fileID: -3215410960346549969, guid: 23c6f322321434e11b4e4a6f2df080f1, type: 3}
  - characterName: "\u0421\u0442\u0430\u0440\u0435\u0439\u0448\u0438\u043D\u0430"
    dialogueText: "\u0418\u0437 \u043F\u0435\u0449\u0435\u0440\u044B \u0410\u043C\u0431\u044B \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u043B\u0441\u044F \u043A \u043D\u0430\u043C"
    characterSprite: {fileID: -6897611254400542825, guid: e804fbc5e9c7940a19756dbe63f78b0f, type: 3}
  - characterName: "\u0421\u0442\u0430\u0440\u0435\u0439\u0448\u0438\u043D\u0430"
    dialogueText: "\u0422\u044B \u0431\u044B\u043B \u0431\u044B \u0434\u043E\u0441\u0442\u043E\u0439\u043D\u043E\u0439 \u0447\u0430\u0441\u0442\u044C\u044E \u043D\u0430\u0448\u0435\u0433\u043E \u043F\u043B\u0435\u043C\u0435\u043D\u0438"
    characterSprite: {fileID: -6897611254400542825, guid: e804fbc5e9c7940a19756dbe63f78b0f, type: 3}
  - characterName: "\u0411\u043E\u0433\u0434\u0430\u043D"
    dialogueText: "\u0422\u043E \u0435\u0441\u0442\u044C, \u043C\u043D\u0435 \u043C\u043E\u0436\u043D\u043E \u043E\u0441\u0442\u0430\u0442\u044C\u0441\u044F??"
    characterSprite: {fileID: 4066236575460678073, guid: ef6ac9285212b4de38ec82c5f12f54af, type: 3}
  - characterName: "\u0421\u0442\u0430\u0440\u0435\u0439\u0448\u0438\u043D\u0430"
    dialogueText: "\u0414\u0443\u043C\u0430\u044E \u0434\u0430"
    characterSprite: {fileID: -6897611254400542825, guid: e804fbc5e9c7940a19756dbe63f78b0f, type: 3}
  - characterName: "\u0421\u0442\u0430\u0440\u0435\u0439\u0448\u0438\u043D\u0430"
    dialogueText: "\u0422\u044B \u0434\u043E\u0441\u0442\u043E\u0438\u043D \u044D\u0442\u043E\u0433\u043E."
    characterSprite: {fileID: -6897611254400542825, guid: e804fbc5e9c7940a19756dbe63f78b0f, type: 3}
