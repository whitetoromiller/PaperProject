  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f1fbfdbcd084b46b4a80017c7d9e2d64, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  dialoguePrefab: {fileID: 5190122297449860569, guid: 585e17f19f0dd4645b755d716a43f03d, type: 3}
  dialogueLines:
  - characterName: "\u0421\u0442\u0430\u0440\u0435\u0439\u0448\u0438\u043D\u0430"
    dialogueText: "\u041A\u0442\u043E \u0442\u044B \u0442\u0430\u043A\u043E\u0432?"
    characterSprite: {fileID: -3215410960346549969, guid: 23c6f322321434e11b4e4a6f2df080f1, type: 3}
  - characterName: "\u0411\u043E\u0433\u0434\u0430\u043D"
    dialogueText: "\u0420\u0443\u0441\u0441\u043A\u0438\u0439 \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u044F, \u043A\u0440\u0435\u0441\u0442\u044C\u044F\u043D\u0438\u043D, \u0411\u043E\u0433\u0434\u0430\u043D\u043E\u043C \u043A\u043B\u0438\u0447\u0443\u0442."
    characterSprite: {fileID: 1415015729033896243, guid: 45f0e061ca13b45a5bf2c225ad4e3e9e, type: 3}
  - characterName: "\u0411\u043E\u0433\u0434\u0430\u043D"
    dialogueText: "\u041A \u0437\u0435\u043C\u043B\u044F\u043C \u043D\u0430 \u0432\u043E\u0441\u0442\u043E\u043A \u0448\u0451\u043B, \u043A \u0440\u043E\u0434\u043D\u044B\u043C \u043D\u0430 \u0441\u0442\u043E\u0440\u043E\u043D\u0435. \u0421 \u0441\u0435\u043C\u044C\u0435\u0439..."
    characterSprite: {fileID: 1415015729033896243, guid: 45f0e061ca13b45a5bf2c225ad4e3e9e, type: 3}
  - characterName: "\u0421\u0442\u0430\u0440\u0435\u0439\u0448\u0438\u043D\u0430"
    dialogueText: "\u0423 \u043D\u0430\u0441 \u0447\u0443\u0436\u0430\u043A\u0430\u043C \u043D\u0435 \u043C\u0435\u0441\u0442\u043E, \u043A\u0430\u0437\u043D\u0438\u0442\u044C \u0442\u0435\u0431\u044F \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u043E"
    characterSprite: {fileID: -3215410960346549969, guid: 23c6f322321434e11b4e4a6f2df080f1, type: 3}
  - characterName: "\u0411\u043E\u0433\u0434\u0430\u043D"
    dialogueText: "\u041F\u0440\u043E\u0448\u0443, \u0441\u043C\u0438\u043B\u0443\u0439\u0442\u0435\u0441\u044C..."
    characterSprite: {fileID: 3165548888171744600, guid: 97021c41591314648863ebe130ebe3c4, type: 3}
  - characterName: "\u0421\u0442\u0430\u0440\u0435\u0439\u0448\u0438\u043D\u0430"
    dialogueText: "\u0425\u043C..."
    characterSprite: {fileID: -6897611254400542825, guid: e804fbc5e9c7940a19756dbe63f78b0f, type: 3}
  - characterName: "\u0421\u0442\u0430\u0440\u0435\u0439\u0448\u0438\u043D\u0430"
    dialogueText: "\u0425\u043E\u0440\u043E\u0448\u043E, \u0434\u0430\u044E \u0442\u0435\u0431\u0435 \u0448\u0430\u043D\u0441. \u0422\u044B \u043C\u043E\u0436\u0435\u0448\u044C \u043F\u043E\u043C\u043E\u0447\u044C \u043D\u0430\u043C \u0438 \u043C\u044B \u043E\u0442\u0432\u0435\u0434\u0435\u043C \u0442\u0435\u0431\u044F \u043D\u0430 \u0432\u043E\u0441\u0442\u043E\u043A \u043A \u0442\u0432\u043E\u0438\u043C"
    characterSprite: {fileID: -6897611254400542825, guid: e804fbc5e9c7940a19756dbe63f78b0f, type: 3}
  - characterName: "\u0421\u0442\u0430\u0440\u0435\u0439\u0448\u0438\u043D\u0430"
    dialogueText: "\u0414\u043E\u0441\u0442\u0430\u043D\u0435\u0448\u044C \u043D\u0430\u043C \u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442 \u0438\u0437 \u043F\u0435\u0449\u0435\u0440\u044B, \u043E\u0445\u0440\u0430\u043D\u044F\u0435\u043C\u043E\u0439 \u0434\u0443\u0445\u043E\u043C \u0410\u043C\u0431\u0430 \u0438 \u0441\u043E\u0431\u0435\u0440\u0435\u0448\u044C \u043D\u0430\u043C \u044F\u0433\u043E\u0434"
    characterSprite: {fileID: -6897611254400542825, guid: e804fbc5e9c7940a19756dbe63f78b0f, type: 3}
  - characterName: "\u0421\u0442\u0430\u0440\u0435\u0439\u0448\u0438\u043D\u0430"
    dialogueText: "\u0410 \u0435\u0441\u043B\u0438 \u043D\u0435\u0442..."
    characterSprite: {fileID: -3215410960346549969, guid: 23c6f322321434e11b4e4a6f2df080f1, type: 3}
  - characterName: "\u0411\u043E\u0433\u0434\u0430\u043D"
    dialogueText: "\u042F \u0432\u0441\u0451 \u0441\u0434\u0435\u043B\u0430\u044E!"
    characterSprite: {fileID: 1415015729033896243, guid: 45f0e061ca13b45a5bf2c225ad4e3e9e, type: 3}
  - characterName: "\u0421\u0442\u0430\u0440\u0435\u0439\u0448\u0438\u043D\u0430"
    dialogueText: "\u0425\u043E\u0440\u043E\u0448\u043E, \u043C\u043E\u0436\u0435\u0448\u044C \u043D\u0430\u0447\u0438\u043D\u0430\u0442\u044C"
    characterSprite: {fileID: -6897611254400542825, guid: e804fbc5e9c7940a19756dbe63f78b0f, type: 3}
