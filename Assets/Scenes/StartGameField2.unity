MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 696325422}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f1fbfdbcd084b46b4a80017c7d9e2d64, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  dialoguePrefab: {fileID: 5190122297449860569, guid: 585e17f19f0dd4645b755d716a43f03d, type: 3}
  dialogueLines:
  - characterName: "\u0410\u043D\u0442\u043E\u043D"
    dialogueText: "\u0411\u043E\u0433\u0434\u0430- \u041F\u043E\u0433\u043E\u0434\u0438. "
    characterSprite: {fileID: 2845491494293411322, guid: 702d91e8ec55546738765ca6ed379c4c, type: 3}
  - characterName: "\u0410\u043D\u0442\u043E\u043D"
    dialogueText: "\u0410 \u043A\u0430\u043A \u0442\u044B \u0432\u044B\u0436\u0438\u043B?"
    characterSprite: {fileID: 5379157725843977334, guid: e8793c45a19bf43b887374298e3c4ff5, type: 3}
  - characterName: "\u0411\u043E\u0433\u0434\u0430\u043D"
    dialogueText: "\u0412 \u0441\u043C\u044B\u0441\u043B\u0435?"
    characterSprite: {fileID: 1415015729033896243, guid: 45f0e061ca13b45a5bf2c225ad4e3e9e, type: 3}
  - characterName: "\u0410\u043D\u0442\u043E\u043D"
    dialogueText: "\u041D\u0438\u043A\u0442\u043E \u043D\u0435 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u043B\u0441\u044F \u0441 \u043F\u0435\u0449\u0435\u0440\u044B \u0410\u043C\u0431\u044B."
    characterSprite: {fileID: 2845491494293411322, guid: 702d91e8ec55546738765ca6ed379c4c, type: 3}
  - characterName: "\u0411\u043E\u0433\u0434\u0430\u043D"
    dialogueText: "\u041D\u0443, \u044F \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F"
    characterSprite: {fileID: 561893497712537133, guid: 385f3cd55501e46e184f86a59db9d172, type: 3}
  - characterName: "\u0410\u043D\u0442\u043E\u043D"
    dialogueText: "\u041B\u0430\u0434\u043D\u043E, \u043F\u043E\u0445\u043E\u0436\u0435 \u0442\u044B \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u044B\u0439. \u041D\u0435 \u0445\u043E\u0447\u0443 \u0442\u0435\u0431\u044F \u0442\u0430\u043A \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0442\u044C."
    characterSprite: {fileID: 878463355533298886, guid: ec8c55271a1204ea4886055ab20b4d82, type: 3}
  - characterName: "\u0410\u043D\u0442\u043E\u043D"
    dialogueText: "\u042F\u0433\u043E\u0434\u044B \u0434\u0430\u043B\u044C\u0448\u0435 \u043F\u043E \u0442\u0440\u043E\u043F\u0438\u043D\u043A\u0435, \u0435\u0441\u043B\u0438 \u0447\u0442\u043E"
    characterSprite: {fileID: -5692479052426527274, guid: 9c11591b456524a8c975150206bfdbfa, type: 3}
  - characterName: "\u0411\u043E\u0433\u0434\u0430\u043D"
    dialogueText: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E, \u0410\u043D\u0442\u043E\u043D"
    characterSprite: {fileID: 1415015729033896243, guid: 45f0e061ca13b45a5bf2c225ad4e3e9e, type: 3}
  - characterName: "\u0410\u043D\u0442\u043E\u043D"
    dialogueText: ...
    characterSprite: {fileID: -8047051033378874645, guid: 949afeecdf4924becad7dc5468c9fca5, type: 3}
